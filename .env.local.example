# Copy to .env.local and fill in your values.

# The backend API this frontend calls (see ../backend). Local dev default shown;
# point at the deployed Render URL to test against production data.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project credentials — same project the backend uses, but these are the
# public anon key (safe to expose client-side; RLS policies do the real gating).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
